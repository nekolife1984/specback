{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nekolife1984/specback/schemas/state.schema.json",
  "title": "state.json",
  "description": "specback のセッション状態。現在の Phase、各 Phase の進捗、履歴を記録する。\nSQLite trace DB (trace.db) との双方向同期をサポートする (trace_db.py)。",
  "type": "object",
  "properties": {
    "current_phase": {
      "type": "integer",
      "description": "現在の Phase 番号（0-7）",
      "minimum": 0,
      "maximum": 7
    },
    "phase_progress": {
      "type": "object",
      "description": "各 Phase の進捗状況",
      "patternProperties": {
        "^phase_\\d+$": {
          "type": "object",
          "properties": {
            "total_subtasks": { "type": "integer", "minimum": 0 },
            "completed_subtasks": { "type": "integer", "minimum": 0 },
            "blocked_subtasks": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["total_subtasks", "completed_subtasks", "blocked_subtasks"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "all_quality_gates_passed": {
      "type": "boolean",
      "description": "全品質ゲート通過済みか"
    },
    "generated_at_commit": {
      "type": ["string", "null"],
      "description": "Phase 7d で記録する生成時点の git commit（40桁 hex SHA）。git mode の drift 検出 base（git_utils.resolve_base / detect-drift / change-spec が自動利用）。commit 不明時または hash mode（Git リポジトリ不使用）では null か省略。",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "started_at": {
      "type": "string",
      "description": "セッション開始日時（ISO 8601）",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "description": "最終更新日時（ISO 8601）",
      "format": "date-time"
    },
    "session_history": {
      "type": "array",
      "description": "セッションイベント履歴",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "phase": {
            "type": "integer",
            "minimum": 0
          },
          "event": {
            "type": "string"
          }
        },
        "required": ["timestamp", "phase", "event"],
        "additionalProperties": false
      }
    },
    "adw_id": {
      "type": "string",
      "description": "SQLite trace DB のセッションID (trace_db.py)"
    },
    "trace_db_path": {
      "type": "string",
      "description": ".specback/ からの相対パス又は trace.db への絶対パス"
    },
    "trace_db_version": {
      "type": "integer",
      "description": "trace.db のスキーマバージョン",
      "minimum": 1,
      "maximum": 1
    },
    "questions": {
      "type": "array",
      "description": "Question Bank（SQLite questions_bank テーブルのエクスポート）",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "body": { "type": "string" },
          "severity": { "type": "string" },
          "status": { "type": "string" },
          "resolution": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "chapter_drafts": {
      "type": "object",
      "description": "チャプタードラフト品質メトリクス（SQLite chapter_drafts テーブルのエクスポート）",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "content_hash": { "type": "string" },
          "ref_count": { "type": "integer" },
          "total_lines": { "type": "integer" },
          "confidence_ratio": { "type": "number" }
        }
      }
    }
  },
  "required": [
    "current_phase",
    "phase_progress",
    "started_at",
    "last_updated"
  ],
  "additionalProperties": false
}

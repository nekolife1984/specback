{
  "schema_version": "1.0.0",
  "description": "Machine-readable registry of spec templates. Each entry mirrors the YAML frontmatter of templates/<name>.md (template_name, description, detection_rules) plus the chapter outline (### Chapter N: Title headings) and the languages the template targets. Catalog is canonical: run scripts/validate-template-catalog.py to verify consistency with the template files.",
  "templates": [
    {
      "name": "api-service",
      "description": "API service spec template. For microservices and public APIs that expose REST/GraphQL/gRPC.",
      "template_version": "0.1.0",
      "chapters": [
        "Overview",
        "Feature specifications",
        "Architecture overview",
        "Class / Module Design",
        "Endpoint catalogue",
        "Request / response specifications",
        "Data Model",
        "Error codes / error responses",
        "External interfaces",
        "Authentication",
        "Rate limiting / quotas",
        "Versioning",
        "SLA / performance requirements",
        "Operations settings",
        "Design decisions",
        "Known constraints and unresolved items"
      ],
      "detection_rules": {
        "always_include": [
          "ch-overview",
          "ch-feature-specs",
          "ch-architecture",
          "ch-design-decisions",
          "ch-known-constraints"
        ],
        "chapters": [
          "ch-endpoint-catalogue",
          "ch-auth",
          "ch-rate-limiting",
          "ch-sla",
          "ch-request-response",
          "ch-error-codes",
          "ch-versioning",
          "ch-operations"
        ],
        "extra_chapters": [
          "ch-webhooks"
        ],
        "optional": [
          "ch-rate-limiting",
          "ch-sla",
          "ch-error-codes",
          "ch-versioning"
        ]
